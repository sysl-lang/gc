module sh.sysl.gc
@tests

import sysl.raw.ptr_cast
import sysl.testing.skip

// What this collector claims, run by `sysl test .`.
//
// The client here is a miniature of the thing the package exists for: object kinds with different
// layouts and different hooks, reached from a root set the test controls exactly. Every assertion is
// about what survives a collection and what does not, which is the only question a collector answers.

private const SLOTS: usize = 4
private const ENTRIES: usize = 4

// An object with a fixed bag of references, like a JavaScript object's properties.
private struct Obj
    tag: int
    props: [SLOTS]*u8

// A different layout with a different tracer, so that type erasure is exercised rather than
// asserted: a heap holding one kind of object would pass these tests with the hook ignored.
private struct Chain
    step: int
    next: *u8

// A `WeakRef`: its tracer marks nothing, and its `Weaker` nulls the target once marking has decided
// the target is dead.
private struct WeakRef
    target: *u8

// A `WeakMap`: keys are held weakly, and a value is marked only because its key was.
private struct WeakMap
    keys: [ENTRIES]*u8
    vals: [ENTRIES]*u8

private trace_obj(p: *u8, h: *Heap)
    val o: *Obj = ptr_cast(p)
    for i in 0..<SLOTS
        mark(h, o.props[i])

private trace_chain(p: *u8, h: *Heap)
    val c: *Chain = ptr_cast(p)
    mark(h, c.next)

private trace_nothing(p: *u8, h: *Heap)
    return

private var finalized: int = 0

// Which heap the last finalizer call was handed, so a test can tell it is the one being swept.
private var finalized_on: *Heap = null

private count_finalize(p: *u8, h: *Heap)
    finalized += 1
    finalized_on = h

private weaken_weakref(p: *u8, h: *Heap)
    var w: *WeakRef = ptr_cast(p)
    if w.target != null && !is_live(h, w.target)
        w.target = null

private weaken_weakmap(p: *u8, h: *Heap)
    var m: *WeakMap = ptr_cast(p)
    for i in 0..<ENTRIES
        if m.keys[i] != null && !is_live(h, m.keys[i])
            m.keys[i] = null
            m.vals[i] = null

// A value is marked because its key is live, and never otherwise. Answering `true` is what asks the
// collector to run marking again, since this value may itself be some other entry's key.
private ephemeron_weakmap(p: *u8, h: *Heap) -> bool
    var m: *WeakMap = ptr_cast(p)
    var did = false
    for i in 0..<ENTRIES
        if m.keys[i] != null && m.vals[i] != null
            if is_live(h, m.keys[i]) && !is_live(h, m.vals[i])
                mark(h, m.vals[i])
                did = true
    did

// How many objects the sweep tests make, and one counter per object for a finalizer to tick. A
// count of calls alone would pass a sweep that finalized one object twice and another not at all;
// a counter per tag says which object each call was handed.
private const COUNT: usize = 120
private var seen: [COUNT]int = [0; COUNT]

private record_finalize(p: *u8, h: *Heap)
    val o: *Obj = ptr_cast(p)
    seen[usize(o.tag)] += 1

private clear_seen()
    for i in 0..<COUNT
        seen[i] = 0

private var obj_kind: Kind = Kind(&trace_obj, null, null, null)
private var recorded_kind: Kind = Kind(&trace_obj, &record_finalize, null, null)
private var chain_kind: Kind = Kind(&trace_chain, null, null, null)
private var counted_kind: Kind = Kind(&trace_obj, &count_finalize, null, null)
private var weakref_kind: Kind = Kind(&trace_nothing, null, &weaken_weakref, null)
private var weakmap_kind: Kind = Kind(&trace_nothing, null, &weaken_weakmap, &ephemeron_weakmap)

private new_obj_of(h: *Heap, tag: int, k: *Kind) -> *Obj
    val raw = alloc(h, sizeof(Obj), k)
    assert(raw != null, "the test's block is big enough for the objects the test makes")
    var o: *Obj = ptr_cast(raw)
    o.tag = tag
    for i in 0..<SLOTS
        o.props[i] = null
    o

private new_obj(h: *Heap, tag: int) -> *Obj = new_obj_of(h, tag, &obj_kind)

private new_chain(h: *Heap, step: int) -> *Chain
    val raw = alloc(h, sizeof(Chain), &chain_kind)
    assert(raw != null, "the test's block is big enough for the chain the test makes")
    var c: *Chain = ptr_cast(raw)
    c.step = step
    c.next = null
    c

private new_weakref(h: *Heap, target: *u8) -> *WeakRef
    val raw = alloc(h, sizeof(WeakRef), &weakref_kind)
    assert(raw != null, "room for a WeakRef")
    var w: *WeakRef = ptr_cast(raw)
    w.target = target
    w

private new_weakmap(h: *Heap) -> *WeakMap
    val raw = alloc(h, sizeof(WeakMap), &weakmap_kind)
    assert(raw != null, "room for a WeakMap")
    var m: *WeakMap = ptr_cast(raw)
    for i in 0..<ENTRIES
        m.keys[i] = null
        m.vals[i] = null
    m

// The root set is module storage the tracers below read, which is how a test says "these and only
// these are live" without the collector knowing anything about a test.
private var root_a: *u8 = null
private var root_b: *u8 = null

private roots_ab(h: *Heap)
    mark(h, root_a)
    mark(h, root_b)

private no_roots(h: *Heap)
    return

private fresh(bytes: usize) -> []u8 = [0; bytes]

// -- Reachability ------------------------------------------------------------------------------

@test("an unreachable cycle is collected, which is the whole reason to trace")
cycle_is_collected()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)

    val keep = new_obj(&h, 1)
    val a = new_obj(&h, 2)
    val b = new_obj(&h, 3)

    // a and b hold each other and nothing else holds either: a reference count never reaches zero.
    a.props[0] = ptr_cast(b)
    b.props[0] = ptr_cast(a)

    root_a = ptr_cast(keep)
    root_b = null

    assert_eq(live(&h), 3)
    collect(&h, &roots_ab)
    assert_eq(live(&h), 1, "the cycle goes, the root stays")
end cycle_is_collected

@test("everything reachable from a root survives, however it is reached")
reachable_survives()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)

    val a = new_obj(&h, 1)
    val b = new_obj(&h, 2)
    val c = new_obj(&h, 3)

    // b is reached twice and c only through b, so a correct mark visits b once and still finds c.
    a.props[0] = ptr_cast(b)
    a.props[1] = ptr_cast(b)
    b.props[0] = ptr_cast(c)

    root_a = ptr_cast(a)
    root_b = null

    collect(&h, &roots_ab)
    assert_eq(live(&h), 3, "sharing is not double-freeing")
    assert_eq(c.tag, 3, "and the far object is intact")
end reachable_survives

@test("a chain deeper than any stack marks iteratively")
deep_chain_costs_no_stack()
    var block = fresh(4194304)
    var h = heap(&block[0], 4194304, null)

    // Deep enough that a recursive mark phase would overflow before it finished.
    val depth = 20000
    var head = new_chain(&h, 0)
    var tail = head
    for i in 1..<depth
        val link = new_chain(&h, i)
        tail.next = ptr_cast(link)
        tail = link

    root_a = ptr_cast(head)
    root_b = null

    assert_eq(live(&h), usize(depth))
    collect(&h, &roots_ab)
    assert_eq(live(&h), usize(depth), "every link is reachable and every link survives")

    collect(&h, &no_roots)
    assert_eq(live(&h), 0, "and the whole chain comes apart in one sweep")
end deep_chain_costs_no_stack

@test("swept storage is reused instead of growing the block")
storage_is_reused()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)

    var i = 0
    while i < 100
        val junk = new_obj(&h, i)
        i += 1

    val high_water = used(&h)
    assert_eq(live(&h), 100)

    root_a = null
    root_b = null
    collect(&h, &roots_ab)
    assert_eq(live(&h), 0)

    var j = 0
    while j < 100
        val again = new_obj(&h, j)
        j += 1

    assert_eq(live(&h), 100)
    assert_eq(used(&h), high_water, "the second hundred came off the free list")
end storage_is_reused

@test("live_size rises with allocation and falls with a sweep, where used only ever rises")
live_size_is_the_one_to_schedule_by()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)

    assert_eq(live_size(&h), 0)

    var i = 0
    while i < 100
        val junk = new_obj(&h, i)
        i += 1

    val held = live_size(&h)
    val high_water = used(&h)

    assert(held > 0, "a hundred objects cost something")
    assert_eq(held, high_water, "and nothing has been reused yet, so the two agree")

    root_a = null
    root_b = null
    collect(&h, &roots_ab)

    // **The whole point of the pair.** A client thresholding on `used` would see the high-water mark
    // it saw before the sweep and collect again immediately, and again after that, forever.
    assert_eq(live_size(&h), 0, "the sweep gave every byte back")
    assert_eq(used(&h), high_water, "while the high-water mark is where it was")
end live_size_is_the_one_to_schedule_by

@test("live_size counts what a reused block costs, not what was asked for")
live_size_follows_the_block()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)

    root_a = ptr_cast(new_obj(&h, 1))

    val one = live_size(&h)

    root_a = null
    collect(&h, &roots_ab)
    assert_eq(live_size(&h), 0)

    // Off the free list this time, and it costs the same as it did when it was fresh.
    root_a = ptr_cast(new_obj(&h, 2))
    assert_eq(live_size(&h), one)

    root_a = null
end live_size_follows_the_block

@test("two object kinds are traced by their own hooks")
type_erasure_holds()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)

    // An Obj pointing at a Chain pointing at an Obj: every edge crosses a layout boundary, so a
    // sweep that survives this one is reading the hook rather than assuming a shape.
    val head = new_obj(&h, 1)
    val middle = new_chain(&h, 2)
    val far = new_obj(&h, 3)

    head.props[0] = ptr_cast(middle)
    middle.next = ptr_cast(far)

    val orphan = new_chain(&h, 99)

    root_a = ptr_cast(head)
    root_b = null

    assert_eq(live(&h), 4)
    collect(&h, &roots_ab)
    assert_eq(live(&h), 3, "the orphaned Chain goes and the reached one does not")
    assert_eq(far.tag, 3, "traced across two layouts")
end type_erasure_holds

@test("a full heap answers null rather than writing past its block")
exhaustion_is_reported()
    // Room for a handful of objects and no more.
    var block = fresh(256)
    var h = heap(&block[0], 256, null)

    var made = 0
    loop
        val p = alloc(&h, sizeof(Obj), &obj_kind)
        if p == null then break
        made += 1

    assert(made > 0, "a 256-byte block fits something")
    assert(alloc(&h, sizeof(Obj), &obj_kind) == null, "and it stays refused once full")
    assert(used(&h) <= 256, "the high-water mark never passes the block")

    root_a = null
    root_b = null
    collect(&h, &roots_ab)
    assert_eq(live(&h), 0)
    assert(alloc(&h, sizeof(Obj), &obj_kind) != null, "and the block is usable again")
end exhaustion_is_reported

@test("two roots each keep their own graph")
roots_are_independent()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)

    val a = new_obj(&h, 1)
    val a_child = new_obj(&h, 2)
    a.props[0] = ptr_cast(a_child)

    val b = new_obj(&h, 3)
    val b_child = new_obj(&h, 4)
    b.props[0] = ptr_cast(b_child)

    root_a = ptr_cast(a)
    root_b = ptr_cast(b)
    collect(&h, &roots_ab)
    assert_eq(live(&h), 4, "both graphs held")

    root_b = null
    collect(&h, &roots_ab)
    assert_eq(live(&h), 2, "dropping one root takes its child with it")
    assert_eq(a_child.tag, 2, "and leaves the other graph alone")
end roots_are_independent

// -- What an allocation costs ------------------------------------------------------------------
//
// These two are about the allocator rather than about reachability, and they are written in the
// only unit that holds on every machine: how many free blocks `alloc` examines. Both interleave the
// objects they free with objects they keep, because adjacent free blocks are merged during the
// sweep -- a run that freed everything would leave one block behind and say nothing about searching.

@test("an allocation that no swept block fits examines a bounded number of them")
alloc_does_not_walk_the_whole_free_list()
    val cap: usize = 48 * 1024 * 1024
    var block = fresh(cap)
    var h = heap(&block[0], cap, null)

    // A hundred thousand small blocks freed, each one separated from the next by a survivor.
    var head: *Chain = null
    var i = 0

    while i < 100000
        var keep = new_chain(&h, i)

        keep.next = ptr_cast(head)
        head = keep

        val junk = new_obj(&h, i)

        i += 1

    root_a = ptr_cast(head)
    root_b = null
    collect(&h, &roots_ab)

    assert_eq(live(&h), 100000, "the survivors are what is left")

    val before = alloc_steps(&h)

    // A kilobyte fits none of them, which under a single first-fit list is the worst case there is:
    // every one of the hundred thousand is examined and rejected before the bump pointer is reached.
    var j = 0

    while j < 10000
        val big = alloc(&h, 1024, &obj_kind)

        assert(big != null, "the block has room for the larger objects")

        j += 1

    val walked = alloc_steps(&h) - before
    val budget: usize = 8 * 10000

    assert(walked <= budget, "a free block a request cannot use is never reached for")
end alloc_does_not_walk_the_whole_free_list

@test("a block swept from a class is handed straight back for that class")
reuse_of_a_class_costs_one_look()
    val cap: usize = 8 * 1024 * 1024
    var block = fresh(cap)
    var h = heap(&block[0], cap, null)

    var head: *Chain = null
    var i = 0

    while i < 20000
        var keep = new_chain(&h, i)

        keep.next = ptr_cast(head)
        head = keep

        val junk = new_obj(&h, i)

        i += 1

    root_a = ptr_cast(head)
    root_b = null
    collect(&h, &roots_ab)

    val high_water = used(&h)
    val before = alloc_steps(&h)

    var j = 0

    while j < 20000
        val again = new_obj(&h, j)

        j += 1

    assert_eq(used(&h), high_water, "twenty thousand objects came off the free list")

    val walked = alloc_steps(&h) - before
    val budget: usize = 4 * 20000

    assert(walked <= budget, "and each one cost a look rather than a walk")
end reuse_of_a_class_costs_one_look

// -- What a sweep gives back -------------------------------------------------------------------

@test("neighbours freed in one sweep become one block, so something larger fits afterwards")
adjacent_free_blocks_merge()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)

    // Small objects until the block is full, and every one of them dies.
    var made = 0

    loop
        val p = alloc(&h, sizeof(Obj), &obj_kind)

        if p == null then break

        made += 1

    assert(made > 0, "a 64K block fits a good few")

    root_a = null
    root_b = null
    collect(&h, &roots_ab)
    assert_eq(live(&h), 0)

    val high_water = used(&h)

    // Nothing in this heap was ever four kilobytes, and the bump pointer has nothing left to give.
    // The only way to answer is out of a run of merged neighbours.
    val big = alloc(&h, 4096, &obj_kind)

    assert(big != null, "a run of merged neighbours holds what no one of them could")
    assert_eq(used(&h), high_water, "and it came out of that run rather than out of fresh block")
end adjacent_free_blocks_merge

@test("a block handed to a smaller request gives its remainder back")
a_split_block_leaves_the_rest_usable()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)

    val big = alloc(&h, 8192, &obj_kind)

    assert(big != null, "the block fits eight kilobytes")

    root_a = null
    root_b = null
    collect(&h, &roots_ab)

    val high_water = used(&h)
    var i = 0

    while i < 64
        val small = alloc(&h, 64, &obj_kind)

        assert(small != null, "each one comes out of what the big block left")

        i += 1

    assert_eq(used(&h), high_water, "sixty-four small objects, and the block never grew")
end a_split_block_leaves_the_rest_usable

@test("a heap filled with mixed sizes, swept and filled again holds exactly as much")
exhaustion_survives_a_round_trip()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)

    var first = 0

    loop
        val p = alloc(&h, 48 + 240 * usize(first % 3), &obj_kind)

        if p == null then break

        first += 1

    assert(first > 0, "the block fits a mixture")

    root_a = null
    root_b = null
    collect(&h, &roots_ab)
    assert_eq(live(&h), 0)
    assert_eq(live_size(&h), 0)

    var again = 0

    loop
        val p = alloc(&h, 48 + 240 * usize(again % 3), &obj_kind)

        if p == null then break

        again += 1

    assert_eq(again, first, "the same mixture fits a second time, so the sweep lost nothing")
    assert(used(&h) <= 65536, "and the high-water mark never passes the block")
end exhaustion_survives_a_round_trip

// -- The non-empty-class mask ------------------------------------------------------------------
//
// The allocator answers "which is the lowest class above this one that has a block" from a bitmap
// rather than by walking the bins, so the bitmap has to agree with the bins at every moment. A bit
// set over an empty bin costs one wasted null check; a bit *clear* over a full one hides that
// storage from the allocator permanently, and the symptom is a heap that answers `null` while most
// of its block is free. These check the agreement itself rather than only its consequences.

// The invariant, over every class: the bit is set if and only if the bin has a block.
private assert_mask_agrees(h: *Heap, note: string)
    for b in 0..<NBINS
        assert(bin_bit(h, b) == !bin_empty(h, b), note)

@test("the mask agrees with the bins through allocation, sweeping and splitting")
the_mask_agrees_with_the_bins()
    val cap: usize = 1024 * 1024
    var block = fresh(cap)
    var h = heap(&block[0], cap, null)

    assert_mask_agrees(&h, "a fresh heap has no classes and no bits")

    // Fresh storage, straight off the bump pointer: nothing is ever pushed to a bin.
    var keep: *Chain = null
    var i = 0

    while i < 400
        var c = new_chain(&h, i)

        c.next = ptr_cast(keep)
        keep = c

        val junk = new_obj(&h, i)

        i += 1

    assert_mask_agrees(&h, "bump allocation touches no class")

    // A sweep, which pushes every dead block onto the class its size belongs to.
    root_a = ptr_cast(keep)
    root_b = null
    collect(&h, &roots_ab)
    assert_mask_agrees(&h, "after a sweep has refilled the bins")

    // Reuse, which unlinks heads -- some leaving their class empty, some not.
    var j = 0

    while j < 400
        val again = new_obj(&h, j)

        assert_mask_agrees(&h, "after an allocation off the free list")

        j += 1

    // A large block taken for a small request, whose remainder goes back to a class of its own.
    root_a = null
    root_b = null
    collect(&h, &roots_ab)
    assert_mask_agrees(&h, "after the second sweep")

    val small = alloc(&h, 32, &obj_kind)

    assert(small != null, "there is a coalesced block to split")
    assert_mask_agrees(&h, "after a split put the remainder back")
end the_mask_agrees_with_the_bins

@test("an allocation whose own class is empty takes the next class that is not")
an_empty_class_reaches_the_next_one()
    val cap: usize = 256 * 1024
    var block = fresh(cap)
    var h = heap(&block[0], cap, null)

    val big = alloc(&h, 16384, &obj_kind)

    assert(big != null, "the block fits sixteen kilobytes")

    root_a = null
    root_b = null
    collect(&h, &roots_ab)

    // One free block, in whatever class its size lands in, and every class below it empty.
    val only = first_bin_from(&h, 0)

    assert(only < NBINS, "the sweep left a free block")
    assert_eq(bin_length(&h, only), 1, "and exactly one")

    val want = class_of_request(sizeof(Obj))

    assert(want < only, "a small object's own class is below it, and is empty")
    assert_eq(bin_length(&h, want), 0)

    val high_water = used(&h)
    val before = alloc_steps(&h)
    val small = new_obj(&h, 1)

    assert_eq(used(&h), high_water, "the small object came off the free list, not the bump pointer")
    assert_eq(alloc_steps(&h) - before, 1, "and it cost one look rather than a climb")
    assert_mask_agrees(&h, "after reaching past an empty class")
end an_empty_class_reaches_the_next_one

@test("a class emptied by the allocation that takes its last block leaves the mask")
the_last_block_of_a_class_clears_its_bit()
    val cap: usize = 1024 * 1024
    var block = fresh(cap)
    var h = heap(&block[0], cap, null)

    // Dead objects separated by survivors, so that no two of them merge and the class keeps them
    // all as blocks of its own size.
    var keep: *Chain = null
    var i = 0

    while i < 200
        var c = new_chain(&h, i)

        c.next = ptr_cast(keep)
        keep = c

        val junk = new_obj(&h, i)

        i += 1

    root_a = ptr_cast(keep)
    root_b = null
    collect(&h, &roots_ab)

    val want = class_of_request(sizeof(Obj))
    val held = bin_length(&h, want)

    assert_eq(held, 200, "every dead object is a block of its own on its own class")
    assert(bin_bit(&h, want), "so the class is in the mask")

    var j: usize = 0

    while j < held - 1
        val again = new_obj(&h, int(j))

        assert(bin_bit(&h, want), "the class still has blocks, so it stays in the mask")

        j += 1

    val last = new_obj(&h, 0)

    assert(!bin_bit(&h, want), "the block that empties the class takes it out of the mask")
    assert_eq(bin_length(&h, want), 0)
    assert_mask_agrees(&h, "and every other class still agrees")
end the_last_block_of_a_class_clears_its_bit

@test("the bit scan answers at both ends of the mask and across its two words")
the_bit_scan_covers_every_class()
    var block = fresh(1024)
    var h = heap(&block[0], 1024, null)

    assert_eq(first_bin_from(&h, 0), NBINS, "an empty mask has no class to offer")

    bin_set(&h, 0)
    assert_eq(first_bin_from(&h, 0), 0, "the lowest class is found at the lowest bit")
    assert_eq(first_bin_from(&h, 1), NBINS, "and nothing above it")

    bin_set(&h, NBINS - 1)
    assert_eq(first_bin_from(&h, 0), 0, "the lowest set bit wins")
    assert_eq(first_bin_from(&h, 1), NBINS - 1, "and the highest class is reachable from below")
    assert_eq(first_bin_from(&h, NBINS - 1), NBINS - 1, "and from itself")
    assert_eq(first_bin_from(&h, NBINS), NBINS, "and there is nothing past the last class")

    bin_clear(&h, 0)
    assert_eq(first_bin_from(&h, 0), NBINS - 1, "a cleared bit is not found")

    // The two words meet between 63 and 64, which is the boundary a shift by a whole word width
    // would get wrong.
    bin_clear(&h, NBINS - 1)
    bin_set(&h, 63)
    bin_set(&h, 64)

    assert_eq(first_bin_from(&h, 0), 63, "the last class of the low word")
    assert_eq(first_bin_from(&h, 63), 63)
    assert_eq(first_bin_from(&h, 64), 64, "the first class of the high word")
    assert_eq(first_bin_from(&h, 65), NBINS, "and nothing above the pair")

    bin_clear(&h, 64)
    assert_eq(first_bin_from(&h, 64), NBINS, "the high word alone decides a query that starts in it")
    assert_eq(first_bin_from(&h, 0), 63)

    bin_clear(&h, 63)
    bin_set(&h, 64)
    assert_eq(first_bin_from(&h, 0), 64, "a query in the low word falls through to the high one")
end the_bit_scan_covers_every_class

@test("the sweep rebuilds the mask from the blocks rather than keeping what it had")
a_sweep_rebuilds_the_mask()
    val cap: usize = 256 * 1024
    var block = fresh(cap)
    var h = heap(&block[0], cap, null)

    var i = 0

    while i < 200
        val junk = new_obj(&h, i)

        i += 1

    // Bits for classes that have nothing on them, which is the state a rebuild must not preserve:
    // the sweep clears both words and lets its own pushes refill them.
    bin_set(&h, 0)
    bin_set(&h, 40)
    bin_set(&h, NBINS - 1)

    root_a = null
    root_b = null
    collect(&h, &roots_ab)

    assert_mask_agrees(&h, "the rebuild answers from the blocks, so the planted bits are gone")
    assert(first_bin_from(&h, 0) < NBINS, "and the coalesced block is in the mask it rebuilt")

    // And it is the storage, not only the bookkeeping, that came back.
    var j = 0

    while j < 200
        val again = new_obj(&h, j)

        j += 1

    assert_mask_agrees(&h, "after the rebuilt mask has been allocated back down")
end a_sweep_rebuilds_the_mask

// -- Finalizers --------------------------------------------------------------------------------

@test("a finalizer runs for what dies and not for what survives")
finalizer_runs_once_per_death()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)
    finalized = 0

    val keep = new_obj_of(&h, 1, &counted_kind)
    val doomed_a = new_obj_of(&h, 2, &counted_kind)
    val doomed_b = new_obj_of(&h, 3, &counted_kind)

    root_a = ptr_cast(keep)
    root_b = null

    collect(&h, &roots_ab)
    assert_eq(finalized, 2, "one per object swept, and none for the survivor")

    collect(&h, &roots_ab)
    assert_eq(finalized, 2, "a second collection does not finalize the survivor again")
end finalizer_runs_once_per_death

@test("a kind with no finalizer is swept without one")
no_finalizer_is_not_a_null_call()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)
    finalized = 0

    val plain = new_obj(&h, 1)
    val counted = new_obj_of(&h, 2, &counted_kind)

    root_a = null
    root_b = null
    collect(&h, &roots_ab)

    assert_eq(live(&h), 0, "both are gone")
    assert_eq(finalized, 1, "and only the kind that has a finalizer ran one")
end no_finalizer_is_not_a_null_call

@test("dispose finalizes what is still live, which is what shutdown needs")
dispose_finalizes_survivors()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)
    finalized = 0

    val a = new_obj_of(&h, 1, &counted_kind)
    val b = new_obj_of(&h, 2, &counted_kind)
    a.props[0] = ptr_cast(b)

    root_a = ptr_cast(a)
    root_b = null
    collect(&h, &roots_ab)
    assert_eq(finalized, 0, "both are reachable, so nothing has died")

    dispose(&h)
    assert_eq(finalized, 2, "teardown runs every finalizer, reachable or not")
    assert_eq(live(&h), 0)
end dispose_finalizes_survivors

// -- The sweep ---------------------------------------------------------------------------------
//
// The sweep walks the block in address order, frees what marking did not reach, relinks the object
// list from the survivors and rebuilds the bins, all in one pass. These pin each of those halves:
// what dies is finalized once and by its own kind, what lives is still on the list afterwards, and
// every cell freed is one the allocator can hand out again.

@test("a kind with no finalizer is swept and its storage handed back")
plain_kind_storage_is_reused()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)

    for i in 0..<COUNT
        val o = new_obj(&h, int(i))

    root_a = null
    root_b = null
    val grown = used(&h)
    collect(&h, &roots_ab)

    assert_eq(live(&h), 0, "nothing was rooted")
    assert_eq(live_size(&h), 0, "and nothing is counted as held")

    for i in 0..<COUNT
        val o = new_obj(&h, int(i))

    assert_eq(used(&h), grown, "the second set fits in exactly what the first one left")
    assert_eq(live(&h), COUNT)
end plain_kind_storage_is_reused

@test("a finalizer is called exactly once for each dead object, and handed that object")
finalizer_once_per_dead_object()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)
    clear_seen()

    var kept: *Obj = null
    for i in 0..<COUNT
        val o = new_obj_of(&h, int(i), &recorded_kind)
        if i == 60 then kept = o

    root_a = ptr_cast(kept)
    root_b = null
    collect(&h, &roots_ab)

    // The first object sits at the block's base and the last against the bump pointer, which are
    // the two ends an address-ordered walk can get wrong.
    for i in 0..<COUNT
        if i == 60
            assert_eq(seen[i], 0, "the survivor is not finalized")
        else
            assert_eq(seen[i], 1, "every dead object is finalized, once, with its own payload")

    collect(&h, &roots_ab)
    for i in 0..<COUNT
        val want = if i == 60 then 0 else 1
        assert_eq(seen[i], want, "a second collection finalizes nothing that was already freed")
    assert_eq(kept.tag, 60, "and the survivor's payload is untouched")
end finalizer_once_per_dead_object

@test("objects of several kinds die in one sweep, each finalized by its own kind or not at all")
mixed_kinds_in_one_sweep()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)
    clear_seen()
    finalized = 0

    var keep_rec: *Obj = null
    var keep_chain: *Chain = null
    val rounds: usize = 40

    for i in 0..<rounds
        val r = new_obj_of(&h, int(i), &recorded_kind)
        val p = new_obj(&h, int(i))
        val c = new_chain(&h, int(i))
        val n = new_obj_of(&h, int(i), &counted_kind)
        if i == 7
            keep_rec = r
            r.props[0] = ptr_cast(p)
            r.props[1] = ptr_cast(n)
        if i == 30 then keep_chain = c

    root_a = ptr_cast(keep_rec)
    root_b = ptr_cast(keep_chain)
    collect(&h, &roots_ab)

    assert_eq(live(&h), 4, "one of each kind survives")
    assert_eq(finalized, 39, "every dead counted object ran its finalizer and no other kind ran it")
    for i in 0..<rounds
        val want = if i == 7 then 0 else 1
        assert_eq(seen[i], want, "every dead recorded object ran its own finalizer once")

    val plain: *Obj = ptr_cast(keep_rec.props[0])
    val counted: *Obj = ptr_cast(keep_rec.props[1])
    assert_eq(keep_rec.tag, 7)
    assert_eq(plain.tag, 7)
    assert_eq(counted.tag, 7)
    assert_eq(keep_chain.step, 30)

    // The object list was relinked from the survivors: teardown reaches each of them exactly once.
    dispose(&h)
    assert_eq(finalized, 40, "the surviving counted object is finalized at teardown")
    assert_eq(seen[7], 1, "and so is the surviving recorded one, once")
end mixed_kinds_in_one_sweep

@test("the sweep hands every freed cell back to the allocator, and no cell twice")
every_freed_cell_is_handed_out()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)

    // Every other object survives, so no two dead cells are neighbours and none is merged: each
    // one comes back as the cell it was.
    var head: *Obj = null
    var dead: [COUNT]usize = [0; COUNT]
    var taken: [COUNT]bool = [false; COUNT]
    var n_dead: usize = 0

    for i in 0..<COUNT
        val o = new_obj(&h, int(i))
        if i % 2 == 0
            o.props[0] = ptr_cast(head)
            head = o
        else
            dead[n_dead] = usize(o)
            n_dead += 1

    root_a = ptr_cast(head)
    root_b = null
    val grown = used(&h)
    collect(&h, &roots_ab)
    assert_eq(live(&h), COUNT / 2)

    for j in 0..<n_dead
        val o = new_obj(&h, 1000)
        assert_eq(used(&h), grown, "served from the free list, not the bump pointer")
        var found = false
        for k in 0..<n_dead
            if dead[k] == usize(o)
                assert(!taken[k], "a freed cell is handed out once")
                taken[k] = true
                found = true
        assert(found, "what comes back is one of the cells that died")

    val extra = new_obj(&h, 0)
    assert(used(&h) > grown, "the free list held exactly the dead cells, and the next comes from the bump pointer")

    var o = head
    var survivors: usize = 0
    while o != null
        assert_eq(o.tag % 2, 0, "the survivors kept their payloads")
        survivors += 1
        o = ptr_cast(o.props[0])
    assert_eq(survivors, COUNT / 2)
end every_freed_cell_is_handed_out

@test("a weak object that outlives a sweep of its neighbours is still found by the next weak pass")
weak_survivor_stays_on_the_list()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)

    val target = new_obj(&h, 1)
    for i in 0..<COUNT / 2
        val o = new_obj(&h, int(i))
    val w = new_weakref(&h, ptr_cast(target))
    for i in 0..<COUNT / 2
        val o = new_obj(&h, int(i))

    val t: *u8 = ptr_cast(target)
    root_a = ptr_cast(w)
    root_b = t
    collect(&h, &roots_ab)
    assert_eq(live(&h), 2, "the reference and its target survive; everything between them died")
    assert(w.target == t, "a live target is left alone")
    assert_eq(weak_objects(&h), 1)

    root_b = null
    collect(&h, &roots_ab)
    assert(w.target == null, "the reference was relinked onto the list, so the weak pass cleared it")
    assert_eq(live(&h), 1)
end weak_survivor_stays_on_the_list

// -- Weak references ---------------------------------------------------------------------------

@test("a weak reference does not keep its target alive and is cleared when it dies")
weak_ref_is_cleared()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)

    val target = new_obj(&h, 42)
    val w = new_weakref(&h, ptr_cast(target))

    // Only the WeakRef is rooted. A strong reference would keep the target; this must not.
    root_a = ptr_cast(w)
    root_b = null

    assert_eq(live(&h), 2)
    collect(&h, &roots_ab)

    assert_eq(live(&h), 1, "the target was not kept alive by the weak reference")
    assert(w.target == null, "and the slot was cleared rather than left dangling")
end weak_ref_is_cleared

@test("a weak reference to a live target is left alone")
weak_ref_survives_live_target()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)

    val target = new_obj(&h, 42)
    val w = new_weakref(&h, ptr_cast(target))

    root_a = ptr_cast(w)
    root_b = ptr_cast(target)

    collect(&h, &roots_ab)
    assert_eq(live(&h), 2)
    assert(w.target != null, "a live target is still there")
    assert_eq(ptr_cast[*Obj](w.target).tag, 42, "and it is the same object")
end weak_ref_survives_live_target

// -- Ephemerons --------------------------------------------------------------------------------

@test("a weak map value is kept alive by its key")
ephemeron_key_keeps_value()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)

    val m = new_weakmap(&h)
    val key = new_obj(&h, 1)
    val value = new_obj(&h, 2)
    m.keys[0] = ptr_cast(key)
    m.vals[0] = ptr_cast(value)

    // The value is reachable ONLY through the map, and the map marks nothing itself.
    root_a = ptr_cast(m)
    root_b = ptr_cast(key)

    collect(&h, &roots_ab)
    assert_eq(live(&h), 3, "map, key and value all survive")
    assert_eq(ptr_cast[*Obj](m.vals[0]).tag, 2, "and the value is intact")
end ephemeron_key_keeps_value

@test("a weak map entry whose key died is dropped, and takes its value with it")
ephemeron_dead_key_drops_entry()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)

    val m = new_weakmap(&h)
    val key = new_obj(&h, 1)
    val value = new_obj(&h, 2)
    m.keys[0] = ptr_cast(key)
    m.vals[0] = ptr_cast(value)

    // Only the map is rooted this time.
    root_a = ptr_cast(m)
    root_b = null

    collect(&h, &roots_ab)
    assert_eq(live(&h), 1, "the key was not held by the map, so key and value both went")
    assert(m.keys[0] == null, "and the entry was cleared before the storage was freed")
    assert(m.vals[0] == null)
end ephemeron_dead_key_drops_entry

@test("a value referring back to its own key does not keep the pair alive")
ephemeron_self_reference_is_collected()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)

    val m = new_weakmap(&h)
    val key = new_obj(&h, 1)
    val value = new_obj(&h, 2)

    // `wm.set(node, {owner: node})` -- the ordinary shape, and the one a collector that marks weak
    // map values strongly would keep alive for as long as the map lives. That is the leak a weak map
    // exists to prevent, and it is invisible to every other test in this file.
    value.props[0] = ptr_cast(key)
    m.keys[0] = ptr_cast(key)
    m.vals[0] = ptr_cast(value)

    root_a = ptr_cast(m)
    root_b = null

    collect(&h, &roots_ab)
    assert_eq(live(&h), 1, "only the map survives; the self-referring pair is garbage")
    assert(m.keys[0] == null)
end ephemeron_self_reference_is_collected

@test("one entry's value being another entry's key resolves by iterating")
ephemeron_chain_reaches_fixpoint()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)

    val m = new_weakmap(&h)
    val k1 = new_obj(&h, 1)
    val v1 = new_obj(&h, 2)
    val v2 = new_obj(&h, 3)

    // v1 is entry 0's value AND entry 1's key. Marking v1 because k1 is live must then make v2 live,
    // which a single pass over the entries finds only if the entries happen to be in the right
    // order -- so the entries are deliberately in the wrong one.
    m.keys[1] = ptr_cast(v1)
    m.vals[1] = ptr_cast(v2)
    m.keys[0] = ptr_cast(k1)
    m.vals[0] = ptr_cast(v1)

    root_a = ptr_cast(m)
    root_b = ptr_cast(k1)

    collect(&h, &roots_ab)
    assert_eq(live(&h), 4, "map, k1, v1 and v2 -- the second entry was reached by re-running")
    assert_eq(ptr_cast[*Obj](m.vals[1]).tag, 3, "and v2 is intact")
end ephemeron_chain_reaches_fixpoint

// -- The weak passes run only where a weak object lives ----------------------------------------

// A map that only has the ephemeron half, and so is counted by one number and not the other.
private var ephemeron_only_kind: Kind = Kind(&trace_nothing, null, null, &ephemeron_weakmap)

@test("a heap holding no weak object collects correctly and never walks for the weak passes")
no_weak_object_skips_both_passes()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)

    val a = new_obj(&h, 1)
    val b = new_chain(&h, 2)
    a.props[0] = ptr_cast(b)
    new_obj(&h, 3)
    new_obj_of(&h, 4, &counted_kind)

    root_a = ptr_cast(a)
    root_b = null

    assert_eq(weak_objects(&h), 0)
    assert_eq(ephemeron_objects(&h), 0)

    collect(&h, &roots_ab)
    collect(&h, &roots_ab)

    assert_eq(live(&h), 2, "a and the chain it holds survive, the other two do not")
    assert_eq(ptr_cast[*Chain](a.props[0]).step, 2, "and what survived is intact")
    assert_eq(weak_walks(&h), 0, "two collections, and neither weak pass walked the object list")
end no_weak_object_skips_both_passes

@test("a weak map drops an entry whose key died and keeps a value its live key reaches, counted once")
weak_map_is_counted_and_its_passes_run()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)

    val m = new_weakmap(&h)
    val live_key = new_obj(&h, 1)
    val kept = new_obj(&h, 2)
    val dead_key = new_obj(&h, 3)
    val dropped = new_obj(&h, 4)
    m.keys[0] = ptr_cast(live_key)
    m.vals[0] = ptr_cast(kept)
    m.keys[1] = ptr_cast(dead_key)
    m.vals[1] = ptr_cast(dropped)

    assert_eq(weak_objects(&h), 1, "one live object whose kind has a weaken hook")
    assert_eq(ephemeron_objects(&h), 1, "and the same one has an ephemeron hook")

    root_a = ptr_cast(m)
    root_b = ptr_cast(live_key)

    collect(&h, &roots_ab)

    assert_eq(live(&h), 3, "the map, the live key and the value only that key reaches")
    assert_eq(ptr_cast[*Obj](m.vals[0]).tag, 2, "the ephemeron-reached value survived intact")
    assert(m.keys[1] == null, "the entry whose key died was dropped")
    assert(m.vals[1] == null)
    assert(weak_walks(&h) >= 2, "an ephemeron round and a weaken pass both walked")
    assert_eq(weak_objects(&h), 1, "the map survived, so it is still counted")
    assert_eq(ephemeron_objects(&h), 1)
end weak_map_is_counted_and_its_passes_run

@test("the count falls when the weak object dies, and the next collection skips the weak passes")
dead_weak_object_stops_the_passes()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)

    val keep = new_obj(&h, 1)
    val m = new_weakmap(&h)
    val w = new_weakref(&h, ptr_cast(keep))
    m.keys[0] = ptr_cast(keep)

    root_a = ptr_cast(keep)
    root_b = null

    assert_eq(weak_objects(&h), 2, "a weak map and a weak reference")
    assert_eq(ephemeron_objects(&h), 1, "only the map has an ephemeron hook")

    // Both weak objects are unreached. The passes still run this time -- the count is of what was
    // live going in -- and the sweep is what lowers it.
    collect(&h, &roots_ab)
    assert_eq(live(&h), 1)
    assert_eq(weak_objects(&h), 0, "both weak objects died and were taken off the count")
    assert_eq(ephemeron_objects(&h), 0)

    val walked = weak_walks(&h)
    assert(walked >= 2, "the collection that freed them still ran both passes")

    new_obj(&h, 2)
    collect(&h, &roots_ab)
    assert_eq(live(&h), 1)
    assert_eq(weak_walks(&h), walked, "and the one after it walked for neither")
end dead_weak_object_stops_the_passes

@test("two heaps keep their own counts")
two_heaps_count_apart()
    var block_a = fresh(65536)
    var block_b = fresh(65536)
    var ha = heap(&block_a[0], 65536, null)
    var hb = heap(&block_b[0], 65536, null)

    new_weakmap(&ha)
    new_weakref(&ha, null)
    new_obj(&hb, 1)

    assert_eq(weak_objects(&ha), 2)
    assert_eq(ephemeron_objects(&ha), 1)
    assert_eq(weak_objects(&hb), 0, "nothing weak was made in the second heap")
    assert_eq(ephemeron_objects(&hb), 0)

    root_a = null
    root_b = null
    collect(&hb, &roots_ab)
    assert_eq(weak_walks(&hb), 0, "the second heap skips both passes whatever the first holds")
    assert_eq(weak_objects(&ha), 2, "and collecting it leaves the first heap's count alone")

    collect(&ha, &roots_ab)
    assert(weak_walks(&ha) >= 2)
    assert_eq(weak_objects(&ha), 0)
end two_heaps_count_apart

@test("dispose zeroes the counts")
dispose_zeroes_the_counts()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)

    new_weakmap(&h)
    new_weakref(&h, null)
    assert_eq(weak_objects(&h), 2)

    dispose(&h)
    assert_eq(weak_objects(&h), 0)
    assert_eq(ephemeron_objects(&h), 0)

    root_a = null
    root_b = null
    collect(&h, &roots_ab)
    assert_eq(weak_walks(&h), 0, "a disposed heap collects with no weak pass")
end dispose_zeroes_the_counts

@test("a kind with only a weaken hook is counted and its pass runs with no ephemeron pass")
weaken_only_kind_counts()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)

    val target = new_obj(&h, 1)
    val w = new_weakref(&h, ptr_cast(target))

    assert_eq(weak_objects(&h), 1)
    assert_eq(ephemeron_objects(&h), 0)

    root_a = ptr_cast(w)
    root_b = null
    collect(&h, &roots_ab)

    assert(w.target == null, "the weaken pass ran and cleared the dead target")
    assert_eq(weak_walks(&h), 1, "one weaken pass and no ephemeron round")
end weaken_only_kind_counts

@test("a kind with only an ephemeron hook is counted and its pass runs with no weaken pass")
ephemeron_only_kind_counts()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)

    // Through `alloc_raw`, so the raw entry point is shown to count as well.
    val raw = alloc_raw(&h, sizeof(WeakMap), &ephemeron_only_kind)
    assert(raw != null)
    var m: *WeakMap = ptr_cast(raw)
    for i in 0..<ENTRIES
        m.keys[i] = null
        m.vals[i] = null

    val key = new_obj(&h, 1)
    val value = new_obj(&h, 2)
    m.keys[0] = ptr_cast(key)
    m.vals[0] = ptr_cast(value)

    assert_eq(weak_objects(&h), 0)
    assert_eq(ephemeron_objects(&h), 1)

    root_a = ptr_cast(m)
    root_b = ptr_cast(key)
    collect(&h, &roots_ab)

    assert_eq(live(&h), 3, "the value was reached through its live key, so the ephemeron pass ran")
    assert_eq(ptr_cast[*Obj](m.vals[0]).tag, 2)
    assert_eq(weak_walks(&h), 2, "two ephemeron rounds -- one that marked, one that found nothing -- and no weaken pass")
end ephemeron_only_kind_counts

// -- a fresh payload is zeroed --------------------------------------------------------------------
//
// **These are over a block filled with 0xFF, and that is the whole point.** `fresh` hands back a
// zeroed array, so every other test in this file runs over a heap that was already clear and would
// pass whether `alloc` zeroed anything or not. A hosted client `malloc`s its block, and a reused one
// holds a dead object's bytes -- neither is zero, and a client storing a `string`, a `Buf` or a `Map`
// into raw bytes releases whatever was there, which is a bus error somewhere else entirely.

private dirty(bytes: usize) -> []u8 = [255; bytes]

@test("a fresh payload is zeroed, over a block that never was")
alloc_zeroes_a_new_payload()
    var block = dirty(65536)
    var h = heap(&block[0], 65536, null)

    val raw = alloc(&h, 64, &obj_kind)

    assert(raw != null, "the block is big enough")

    var dirt = 0

    for i in 0..<64
        if raw[i] != 0u8 then dirt += 1

    assert_eq(dirt, 0, "a first assignment into this releases nothing")
end alloc_zeroes_a_new_payload

@test("a payload reused from the free list is zeroed too")
alloc_zeroes_a_reused_payload()
    var block = dirty(65536)
    var h = heap(&block[0], 65536, null)

    val first = alloc(&h, 64, &obj_kind)

    for i in 0..<64
        first[i] = 171u8

    root_a = null
    root_b = null

    collect(&h, &roots_ab)

    val again = alloc(&h, 64, &obj_kind)

    assert_eq(usize(again), usize(first), "the swept block is what came back")

    var dirt = 0

    for i in 0..<64
        if again[i] != 0u8 then dirt += 1

    assert_eq(dirt, 0, "and the previous tenant's bytes are gone")
end alloc_zeroes_a_reused_payload

@test("a payload split out of a bigger swept block is zeroed too")
alloc_zeroes_a_split_payload()
    var block = dirty(65536)
    var h = heap(&block[0], 65536, null)

    val big = alloc(&h, 8192, &obj_kind)

    assert(big != null, "the block fits eight kilobytes")

    for i in 0..<8192
        big[i] = 171u8

    root_a = null
    root_b = null

    collect(&h, &roots_ab)

    // A small request served out of what that one left behind: a block this test has written over
    // twice, first with the array's 0xFF and then with the object's 0xAB.
    val small = alloc(&h, 64, &obj_kind)

    assert(small != null, "the remainder is usable")

    var dirt = 0

    for i in 0..<64
        if small[i] != 0u8 then dirt += 1

    assert_eq(dirt, 0, "and what comes back is clear whichever block it was cut from")
end alloc_zeroes_a_split_payload

// -- the size-class classifier --------------------------------------------------------------------
//
// **`bin_of` was a shift loop and is now a bit scan, and the only check worth making is that the
// two answer the same thing.** A test written against what the classes *ought* to be is a second
// opinion about the design, and it would pass a rewrite that was consistently wrong; a test written
// against the implementation that shipped is the one that catches a boundary that moved. The loop
// below is `bin_of` as `gc` 0.2.4 had it, character for character apart from its name, and it reads
// the module's own constants so that the two cannot drift apart through a changed `GRAIN`.

private bin_of_by_shifting(size: usize) -> usize
    val i = size / GRAIN

    if i < SMALL_BINS then return i

    var n = size / LARGE_MIN
    var j: usize = 0

    while n > 1 && j < LARGE_BINS - 1
        n = n >> 1
        j += 1

    SMALL_BINS + j
end bin_of_by_shifting

@test("the bit scan classifies every size below 128 kilobytes exactly as the shift loop did")
classifier_agrees_below_128k()
    // Exhaustive over every one of the exact small classes and the first seven geometric ones --
    // every boundary in that range is crossed by this loop rather than being reasoned about.
    var size: usize = 0
    var checked = 0

    while size <= 131072
        assert_eq(bin_of(size), bin_of_by_shifting(size), "the two classifiers disagree")
        size += 1
        checked += 1

    assert_eq(checked, 131073, "and every size in the range was asked")
end classifier_agrees_below_128k

@test("and at every class boundary above it, including the open-ended last one")
classifier_agrees_at_every_boundary()
    // Above 128 kilobytes the function is piecewise by powers of two, so the sizes that can
    // disagree are the boundaries and their neighbours. This walks them to the top of a `usize`
    // rather than to a literal, so it is the same test on a 32-bit target -- where `LARGE_MIN <<
    // 23` does not exist and the last classes are unreachable.
    val top: usize = ~0usize
    var edge: usize = LARGE_MIN
    var crossed = 0

    while edge <= top / 2
        assert_eq(bin_of(edge - 1), bin_of_by_shifting(edge - 1), "just below a boundary")
        assert_eq(bin_of(edge), bin_of_by_shifting(edge), "on a boundary")
        assert_eq(bin_of(edge + 1), bin_of_by_shifting(edge + 1), "just above a boundary")

        edge = edge << 1
        crossed += 1

    assert_eq(bin_of(top), bin_of_by_shifting(top), "and the largest size a usize can hold")
    assert_eq(bin_of(top), NBINS - 1, "which is the open-ended last class")
    assert(crossed >= 21, "a 32-bit usize still crosses this many")
end classifier_agrees_at_every_boundary

@test("every size a request can be made of lands on a class that exists")
classifier_stays_in_range()
    var size: usize = 0

    while size <= 300000
        val b = bin_of(size)

        assert(b < NBINS, "no size classifies past the last bin")

        size += 997

    assert_eq(bin_of(~0usize), NBINS - 1, "and the largest one lands on the last")
end classifier_stays_in_range

// -- alloc_raw ------------------------------------------------------------------------------------
//
// **`alloc_raw` differs from `alloc` in one thing only: it does not clear the payload.** So what
// these check is that everything else is unchanged -- the class the block is cut from, the object
// list it is linked into, the accounting, and that a swept raw object frees its storage like any
// other. The one test that asserts the *absence* of the zeroing runs over a `dirty` block, where
// "not cleared" has an observable value rather than being the same as cleared by luck.

@test("alloc_raw leaves the payload as the block was, which is the whole of what it buys")
raw_payload_is_untouched()
    var block = dirty(65536)
    var h = heap(&block[0], 65536, null)

    val raw = alloc_raw(&h, 64, &obj_kind)

    assert(raw != null, "the block is big enough")

    var kept = 0

    for i in 0..<64
        if raw[i] == 255u8 then kept += 1

    assert_eq(kept, 64, "every byte is still the array's own")

    // The contract, discharged: the caller writes every byte before anything can observe the block.
    for i in 0..<64
        raw[i] = 0u8
end raw_payload_is_untouched

@test("a raw block is cut from the class alloc would have used, and the next one does not overlap it")
raw_block_is_classed_like_any_other()
    var plain = fresh(65536)
    var hp = heap(&plain[0], 65536, null)

    val by_alloc = alloc(&hp, 80, &obj_kind)

    assert(by_alloc != null, "room for the object")

    val cost = live_size(&hp)

    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)

    val first = alloc_raw(&h, 80, &obj_kind)

    assert(first != null, "room for the object")

    for i in 0..<80
        first[i] = 0u8

    assert_eq(live_size(&h), cost, "the same request costs the same block whichever entry point took it")
    assert_eq(class_of_request(80), bin_of(cost), "and that block is the class the request asks for")

    val second = alloc(&h, 80, &obj_kind)

    assert(second != null, "room for the second object")

    val lo = usize(first)
    val hi = usize(second)

    assert(hi >= lo + 80 || lo >= hi + 80, "the two payloads do not overlap")
    assert_eq(live(&h), 2, "and both are on the object list")
end raw_block_is_classed_like_any_other

@test("raw objects are traced, swept and their storage reused like any other")
raw_objects_leak_nothing()
    var block = dirty(1048576)
    var h = heap(&block[0], 1048576, null)

    var round = 0

    while round < 4
        var i = 0

        while i < 2000
            val p = alloc_raw(&h, sizeof(Obj), &obj_kind)

            assert(p != null, "room for the object in round")

            // Every byte, before the next allocation: `tag` and then every slot the tracer reads.
            var o: *Obj = ptr_cast(p)

            o.tag = i

            for s in 0..<SLOTS
                o.props[s] = null

            i += 1

        root_a = null
        root_b = null

        collect(&h, &roots_ab)

        assert_eq(live(&h), 0, "nothing raw survived a collection that roots nothing")
        assert_eq(live_size(&h), 0, "and the bytes came back too")

        round += 1

    assert_eq(round, 4, "four rounds out of storage that only ever held one")
end raw_objects_leak_nothing

// Requests too large to satisfy. Each refusal must answer null, leave every counter, every bin and
// every free list as it was, and never touch a payload byte.

private struct Snap
    live: usize
    live_bytes: usize
    used: usize
    steps: usize
    binned: usize
    first_free: usize

private snap(h: *Heap) -> Snap
    var binned: usize = 0
    var first_free: usize = 0

    for b in 0..<NBINS
        binned += bin_length(h, b) * (b + 1)
        if first_free == 0 && !bin_empty(h, b) then first_free = b + 1

    Snap(live(h), live_size(h), used(h), alloc_steps(h), binned, first_free)

private same(a: Snap, b: Snap) -> bool
    a.live == b.live && a.live_bytes == b.live_bytes && a.used == b.used && a.steps == b.steps && a.binned == b.binned && a.first_free == b.first_free

// Whether both entry points refuse `size`, with the heap's state and the arena's bytes untouched.
private refused(h: *Heap, arena: *u8, len: usize, size: usize) -> bool
    val before = snap(h)
    val a = alloc(h, size, &obj_kind)
    val r = alloc_raw(h, size, &obj_kind)
    var intact = true

    for i in 0..<len
        if arena[i] != 255 && i >= used(h) then intact = false

    a == null && r == null && same(before, snap(h)) && intact

// The largest payload a fresh heap of `cap` bytes can hand out, found by asking.
private largest(cap: usize) -> usize
    var block = dirty(cap)
    var h = heap(&block[0], cap, null)
    var n = cap

    loop
        if alloc_raw(&h, n, &obj_kind) != null then return n
        if n == 0 then return 0
        n -= 1
    0

@test("a request of the largest usize is refused, not wrapped into a small block")
alloc_refuses_max_usize()
    var block = dirty(4096)
    var h = heap(&block[0], 4096, null)

    assert(alloc_raw(&h, ~0usize, &obj_kind) == null, "alloc_raw")
    assert(alloc(&h, ~0usize, &obj_kind) == null, "alloc")
    assert_eq(used(&h), 0, "nothing was carved")
    assert_eq(live(&h), 0, "nothing was counted")
end alloc_refuses_max_usize

@test("the exact boundary of the arena: the largest request fits and one more byte does not")
alloc_boundary_is_exact()
    val top = largest(4096)

    assert(top > 4000 && top < 4096, "the largest payload is the arena less one header")

    var block = dirty(4096)
    var h = heap(&block[0], 4096, null)

    assert(refused(&h, &block[0], 4096, top + 1), "one byte over")
    assert(refused(&h, &block[0], 4096, top + 16), "a grain over")
    assert(alloc_raw(&h, top, &obj_kind) != null, "and the largest still fits after the refusals")
    assert_eq(live(&h), 1)
end alloc_boundary_is_exact

@test("a size whose rounding alone overflows is refused")
alloc_refuses_sizes_that_wrap_when_rounded()
    var block = dirty(4096)
    var h = heap(&block[0], 4096, null)

    for k in 0..<64
        assert(refused(&h, &block[0], 4096, ~0usize - usize(k)), "~0 minus a small k")

    assert(refused(&h, &block[0], 4096, ~0usize / 2), "half the address space")
    assert(refused(&h, &block[0], 4096, ~0usize / 2 + 1), "the sign bit")
end alloc_refuses_sizes_that_wrap_when_rounded

@test("a size that fits arithmetically but exceeds the arena is refused")
alloc_refuses_larger_than_arena()
    var block = dirty(4096)
    var h = heap(&block[0], 4096, null)

    assert(refused(&h, &block[0], 4096, 4096), "the arena itself")
    assert(refused(&h, &block[0], 4096, 8192), "twice the arena")
    assert(refused(&h, &block[0], 4096, 1048576), "a megabyte")
end alloc_refuses_larger_than_arena

@test("an arena claimed to span the whole address space is cut so no request can wrap")
alloc_refuses_wrapping_sizes_on_a_huge_claimed_arena()
    var block = dirty(4096)
    var h = heap(&block[0], ~0usize, null)

    // A zero-byte block is a header rounded up to a grain, so the header is more than a grain
    // exactly when that is more than one.
    var probe = dirty(4096)
    var p = heap(&probe[0], 4096, null)

    assert(alloc_raw(&p, 0, &obj_kind) != null)
    assert(used(&p) > GRAIN, "a header is longer than a grain")

    // Every size from `used(&p) + 14` below the top of the range up to the top. The cut sits a
    // header and `GRAIN - 1` below the top, so these are the sizes that wrap `size + header + grain
    // - 1` to a small block, plus the ones not above the cut whose block rounds past it.
    val low = ~0usize - used(&p) - 14

    for j in 0..<(used(&p) + 15)
        assert(refused(&h, &block[0], 4096, low + j), "from the cut to the top")
    assert(alloc_raw(&h, 64, &obj_kind) != null, "a small request is still served")
end alloc_refuses_wrapping_sizes_on_a_huge_claimed_arena

@test("a refusal changes no state: the next allocation behaves as on a fresh heap")
refusal_leaves_heap_as_fresh()
    var b1 = dirty(4096)
    var b2 = dirty(4096)
    var fresh_heap = heap(&b1[0], 4096, null)
    var refused_heap = heap(&b2[0], 4096, null)

    assert(refused(&refused_heap, &b2[0], 4096, ~0usize), "~0")
    assert(refused(&refused_heap, &b2[0], 4096, ~0usize - 7), "~0 - 7")
    assert(refused(&refused_heap, &b2[0], 4096, 5000), "over the arena")

    val p = alloc(&fresh_heap, 100, &obj_kind)
    val q = alloc(&refused_heap, 100, &obj_kind)

    assert(p != null && q != null, "both allocate")
    assert_eq(usize(q) - usize(&b2[0]), usize(p) - usize(&b1[0]), "at the same offset")
    assert(same(snap(&fresh_heap), snap(&refused_heap)), "with the same counters")
end refusal_leaves_heap_as_fresh

@test("alloc zeroes nothing and writes no length when it refuses")
alloc_refusal_does_not_touch_memory()
    var block = dirty(4096)
    var h = heap(&block[0], 4096, null)

    assert(alloc(&h, ~0usize, &obj_kind) == null)
    assert(alloc(&h, ~0usize - 15, &obj_kind) == null)

    for i in 0..<4096
        assert_eq(block[i], 255, "arena byte")
end alloc_refusal_does_not_touch_memory

@test("a refusal after blocks were freed, split and coalesced still changes nothing")
refusal_after_free_split_coalesce()
    var block = dirty(16384)
    var h = heap(&block[0], 16384, null)

    for i in 0..<40
        assert(alloc(&h, 16 + usize(i % 7) * 40, &obj_kind) != null)

    root_a = null
    root_b = null
    collect(&h, &roots_ab)
    assert_eq(live(&h), 0, "everything swept and coalesced")

    val small = alloc(&h, 24, &obj_kind)

    assert(small != null, "a free block is split")
    assert(refused(&h, &block[0], 0, ~0usize), "~0")
    assert(refused(&h, &block[0], 0, ~0usize - 3), "~0 - 3")
    assert(refused(&h, &block[0], 0, 16385), "over the arena")
    assert_eq(live(&h), 1)
    assert(alloc(&h, 200, &obj_kind) != null, "and the heap still serves")
end refusal_after_free_split_coalesce

// Payload alignment. `heap` enters the arena up to 15 bytes in so that every payload lands on a
// 16-byte boundary whatever address the arena starts at; these tests slide the arena through every
// offset 0..15 of a buffer, which covers every residue of the start address modulo 16.

private aligned(p: *u8) -> bool = p != null && usize(p) % 16 == 0

// Whether `p` and its `size` payload bytes lie inside the `cap` bytes at `base`.
private inside(p: *u8, size: usize, base: *u8, cap: usize) -> bool
    usize(p) >= usize(base) && usize(p) + size <= usize(base) + cap

// The largest payload a fresh heap of `cap` bytes at offset `shift` of a block can hand out.
private largest_from(shift: usize, cap: usize) -> usize
    var block = dirty(cap + 16)
    var h = heap(&block[shift], cap, null)
    var n = cap

    loop
        if alloc_raw(&h, n, &obj_kind) != null then return n
        if n == 0 then return 0
        n -= 1
    0

@test("fresh blocks are 16-byte aligned at every arena offset")
payloads_fresh_are_16_aligned()
    var block = dirty(16384 + 16)

    for shift in 0..<16
        var h = heap(&block[shift], 16384, null)

        for i in 0..<40
            val size = 1 + usize(i) * 13 % 300
            val p = alloc(&h, size, &obj_kind)
            assert(aligned(p), "a fresh block off the bump pointer")
            assert(inside(p, size, &block[shift], 16384), "and it is inside the arena")

            val q = alloc_raw(&h, size, &obj_kind)
            assert(aligned(q), "alloc_raw too")
end payloads_fresh_are_16_aligned

@test("blocks split from a coalesced run are 16-byte aligned at every arena offset")
payloads_split_from_coalesced_are_16_aligned()
    var block = dirty(16384 + 16)

    for shift in 0..<16
        var h = heap(&block[shift], 16384, null)

        for i in 0..<40
            assert(alloc(&h, 1 + usize(i) * 13 % 300, &obj_kind) != null)

        root_a = null
        root_b = null
        collect(&h, &roots_ab)
        assert_eq(live(&h), 0, "everything swept and coalesced")

        for i in 0..<40
            val p = alloc(&h, 1 + usize(i) * 29 % 500, &obj_kind)
            assert(aligned(p), "a block split out of a coalesced run")
            assert(inside(p, 1, &block[shift], 16384))
end payloads_split_from_coalesced_are_16_aligned

@test("blocks split from a freed larger block are 16-byte aligned at every arena offset")
payloads_split_from_free_block_are_16_aligned()
    var block = dirty(16384 + 16)

    for shift in 0..<16
        var h = heap(&block[shift], 16384, null)

        assert(alloc(&h, 3000, &obj_kind) != null)
        root_a = null
        root_b = null
        collect(&h, &roots_ab)

        for i in 0..<20
            assert(aligned(alloc(&h, 8 + usize(i) * 7, &obj_kind)), "a small block carved from the large free one")
end payloads_split_from_free_block_are_16_aligned

@test("blocks reused from their exact class are 16-byte aligned at every arena offset")
payloads_reused_from_exact_class_are_16_aligned()
    var block = fresh(16384 + 16)

    for shift in 0..<16
        var h = heap(&block[shift], 16384, null)
        var prev: *Obj = null

        // Dead and live objects alternate, so each dead one is a hole between live neighbours that
        // coalescing cannot widen, and the next request of its size takes it from its own class.
        for i in 0..<20
            new_obj(&h, 0)
            val live_one = new_obj(&h, 1)
            live_one.props[0] = ptr_cast(prev)
            prev = live_one

        root_a = ptr_cast(prev)
        root_b = null
        collect(&h, &roots_ab)
        assert_eq(live(&h), 20, "the live half survives")

        val top = used(&h)

        for i in 0..<20
            val p = alloc_raw(&h, sizeof(Obj), &obj_kind)
            assert(aligned(p), "a hole reused from its exact class")
            assert(inside(p, sizeof(Obj), &block[shift], 16384))

        assert_eq(used(&h), top, "all twenty came out of the holes, none off the bump pointer")
end payloads_reused_from_exact_class_are_16_aligned

@test("an arena too small for one block refuses cleanly at every offset")
tiny_arenas_refuse_cleanly()
    for cap in 0..<65
        var block = dirty(cap + 48)

        for shift in 0..<16
            var h = heap(&block[shift], cap, null)
            val p = alloc(&h, 1, &obj_kind)

            if cap < 16
                assert(p == null, "no room for a header")

            if p != null
                assert(aligned(p), "a block that does fit is aligned")
                assert(inside(p, 1, &block[shift], cap), "and is inside the arena")
            else
                assert_eq(used(&h), 0, "a refusal carves nothing")
                assert_eq(live(&h), 0)

            assert(alloc_raw(&h, ~0usize, &obj_kind) == null, "the largest request is refused")

            for i in 0..<48
                if i >= cap + shift then assert_eq(block[i], 255, "no byte past the arena is written")
end tiny_arenas_refuse_cleanly

@test("an arena no longer than its lead holds nothing")
arena_shorter_than_lead_holds_nothing()
    var block = dirty(64)

    for shift in 0..<16
        for cap in 0..<16
            var h = heap(&block[shift], cap, null)
            assert(alloc(&h, 1, &obj_kind) == null, "alloc")
            assert(alloc_raw(&h, 0, &obj_kind) == null, "alloc_raw")
            assert_eq(used(&h), 0)
            assert_eq(live_size(&h), 0)
end arena_shorter_than_lead_holds_nothing

@test("the largest satisfiable request at each offset fits, one more byte is refused, and nothing past the arena is written")
largest_request_at_every_offset()
    var best: usize = 0

    for shift in 0..<16
        val top = largest_from(shift, 4096)
        if top > best then best = top

    for shift in 0..<16
        val top = largest_from(shift, 4096)

        assert(best - top <= 16, "the lead costs at most one grain of payload")

        var block = dirty(4096 + 16 + 32)
        var h = heap(&block[shift], 4096, null)

        assert(refused(&h, &block[shift], 4096, top + 1), "one byte over")
        assert(refused(&h, &block[shift], 4096, top + 16), "a grain over")
        assert(refused(&h, &block[shift], 4096, ~0usize - 3), "a size that wraps when rounded")

        val p = alloc(&h, top, &obj_kind)
        assert(aligned(p), "the largest payload is aligned")
        assert(inside(p, top, &block[shift], 4096), "and ends inside the arena")

        for i in 0..<32
            assert_eq(block[shift + 4096 + i], 255, "the guard bytes after the arena are untouched")
end largest_request_at_every_offset

@test("the counters do not depend on the arena offset")
counters_ignore_the_lead()
    var block = fresh(16384 + 16)
    var first: Snap = Snap(0, 0, 0, 0, 0, 0)

    for shift in 0..<16
        var h = heap(&block[shift], 16384, null)

        for i in 0..<30
            assert(alloc(&h, 1 + usize(i) * 13 % 300, &obj_kind) != null)

        root_a = null
        root_b = null
        collect(&h, &roots_ab)

        for i in 0..<30
            assert(alloc(&h, 1 + usize(i) * 29 % 200, &obj_kind) != null)

        val s = snap(&h)

        if shift == 0 then first = s
        assert(same(first, s), "live, live_size, used, steps and the free lists agree with offset 0")
end counters_ignore_the_lead

@test("dispose over an offset arena finalizes everything and leaves it reusable and aligned")
dispose_over_offset_arena()
    var block = fresh(65536 + 16)

    for shift in 0..<16
        var h = heap(&block[shift], 65536, null)
        finalized = 0

        val a = new_obj_of(&h, 1, &counted_kind)
        val b = new_obj_of(&h, 2, &counted_kind)
        a.props[0] = ptr_cast(b)
        assert(aligned(ptr_cast(a)) && aligned(ptr_cast(b)))

        root_a = ptr_cast(a)
        root_b = null
        collect(&h, &roots_ab)
        assert_eq(finalized, 0, "both reachable")

        dispose(&h)
        assert_eq(finalized, 2, "teardown runs every finalizer")
        assert_eq(live(&h), 0)
        assert_eq(live_size(&h), 0)

        for i in 0..<10
            assert(aligned(alloc(&h, 1 + usize(i) * 17, &obj_kind)), "and the disposed heap still hands out aligned blocks")
end dispose_over_offset_arena

@test("an ephemeron keeps its value alive through its key over an offset arena")
ephemeron_over_offset_arena()
    var block = fresh(65536 + 16)

    for shift in 0..<16
        var h = heap(&block[shift], 65536, null)

        val m = new_weakmap(&h)
        val key = new_obj(&h, 1)
        val value = new_obj(&h, 2)
        m.keys[0] = ptr_cast(key)
        m.vals[0] = ptr_cast(value)
        assert(aligned(ptr_cast(m)) && aligned(ptr_cast(key)) && aligned(ptr_cast(value)))

        root_a = ptr_cast(m)
        root_b = ptr_cast(key)
        collect(&h, &roots_ab)
        assert_eq(live(&h), 3, "map, key and value survive")
        assert_eq(ptr_cast[*Obj](m.vals[0]).tag, 2, "and the value is intact")

        root_b = null
        collect(&h, &roots_ab)
        assert_eq(live(&h), 1, "the key died, and the entry and its value with it")
        assert(m.keys[0] == null && m.vals[0] == null)
end ephemeron_over_offset_arena

@test("a weak reference is cleared over an offset arena")
weakref_over_offset_arena()
    var block = fresh(65536 + 16)

    for shift in 0..<16
        var h = heap(&block[shift], 65536, null)

        val target = new_obj(&h, 1)
        val w = new_weakref(&h, ptr_cast(target))
        assert(aligned(ptr_cast(w)))

        root_a = ptr_cast(w)
        root_b = ptr_cast(target)
        collect(&h, &roots_ab)
        assert(w.target != null, "kept while the target is live")

        root_b = null
        collect(&h, &roots_ab)
        assert(w.target == null, "cleared once the target is dead")
end weakref_over_offset_arena

// -- The context, the kind and the finalizer's heap ------------------------------------------------

private var ctx_a: int = 0
private var ctx_b: int = 0

@test("a heap answers the context it was made with, null included")
context_round_trips()
    var block_a = fresh(4096)
    var block_b = fresh(4096)
    var ha = heap(&block_a[0], 4096, ptr_cast(&ctx_a))
    var hb = heap(&block_b[0], 4096, ptr_cast(&ctx_b))
    var hn = heap(&block_a[0], 4096, null)

    assert(context(&ha) == ptr_cast(&ctx_a), "the first heap's own context")
    assert(context(&hb) == ptr_cast(&ctx_b), "the second heap's, not the first's")
    assert(context(&hn) == null, "null is a context like any other")
    assert(context(&ha) != context(&hb))

@test("the context survives allocation, collection and dispose unchanged")
context_survives_the_heap_working()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, ptr_cast(&ctx_a))

    root_a = ptr_cast(new_obj(&h, 1))
    new_obj(&h, 2)
    collect(&h, &roots_ab)
    assert(context(&h) == ptr_cast(&ctx_a), "after a collection")
    dispose(&h)
    assert(context(&h) == ptr_cast(&ctx_a), "after dispose")
    root_a = null

// A finalizer that reaches the client's state through the heap it is handed -- the reason it is
// handed one.
private ctx_finalize(p: *u8, h: *Heap)
    var n: *int = ptr_cast(context(h))
    n[0] += 1

private var ctx_kind: Kind = Kind(&trace_obj, &ctx_finalize, null, null)

@test("a finalizer is handed the heap being swept, and reaches its context through it")
finalizer_reaches_the_context()
    var block_a = fresh(65536)
    var block_b = fresh(65536)
    var ha = heap(&block_a[0], 65536, ptr_cast(&ctx_a))
    var hb = heap(&block_b[0], 65536, ptr_cast(&ctx_b))
    ctx_a = 0
    ctx_b = 0

    for i in 0..<3
        new_obj_of(&ha, i, &ctx_kind)
    for i in 0..<5
        new_obj_of(&hb, i, &ctx_kind)

    collect(&ha, &no_roots)
    assert_eq(ctx_a, 3, "the first heap's three, counted in its own context")
    assert_eq(ctx_b, 0, "and nothing in the other's")

    new_obj_of(&hb, 9, &ctx_kind)
    dispose(&hb)
    assert_eq(ctx_b, 6, "dispose hands its finalizers the heap too")
    assert_eq(ctx_a, 3)

@test("a finalizer's heap is the heap whose sweep or dispose called it")
finalizer_is_handed_its_own_heap()
    var block_a = fresh(65536)
    var block_b = fresh(65536)
    var ha = heap(&block_a[0], 65536, null)
    var hb = heap(&block_b[0], 65536, null)

    new_obj_of(&ha, 1, &counted_kind)
    new_obj_of(&hb, 2, &counted_kind)

    finalized_on = null
    collect(&ha, &no_roots)
    assert(finalized_on == &ha, "the sweep of the first heap hands over the first")

    finalized_on = null
    collect(&hb, &no_roots)
    assert(finalized_on == &hb, "and of the second, the second")

    new_obj_of(&ha, 3, &counted_kind)
    finalized_on = null
    dispose(&ha)
    assert(finalized_on == &ha, "dispose hands over the heap it is emptying")

@test("kind_of answers the kind each object was allocated with")
kind_of_answers_the_allocation_kind()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)

    val a = new_obj(&h, 1)
    val c = new_chain(&h, 2)
    val raw = alloc_raw(&h, sizeof(Obj), &counted_kind)
    val zero_size = alloc(&h, 0, &chain_kind)

    assert(kind_of(ptr_cast(a)) == &obj_kind, "an Obj")
    assert(kind_of(ptr_cast(c)) == &chain_kind, "a Chain, which is a different kind")
    assert(kind_of(raw) == &counted_kind, "an alloc_raw block")
    assert(kind_of(zero_size) == &chain_kind, "a zero-byte object has a kind too")
    assert_eq(KIND_BACK, 2 * sizeof(usize), "two words back, on any target")

@test("a block reused for another kind answers the new kind")
kind_of_follows_reuse()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)

    val first: *u8 = ptr_cast(new_obj(&h, 1))
    collect(&h, &no_roots)
    val second: *u8 = ptr_cast(new_obj_of(&h, 2, &counted_kind))

    assert(second == first, "the swept block is handed straight back")
    assert(kind_of(second) == &counted_kind, "and reports its new kind")

// A client descriptor that begins with a `Kind` and carries its own data after it. The tracer finds
// the descriptor through `kind_of`, which is how a runtime with one tracer for every type works.
private struct Desc
    kind: Kind
    slots: usize
    tag: usize

@assert(offsetof(Desc, kind) == 0, "a client descriptor begins with its Kind")

private trace_by_desc(p: *u8, h: *Heap)
    val d: *Desc = ptr_cast(kind_of(p))
    val o: *Obj = ptr_cast(p)
    for i in 0..<d.slots
        mark(h, o.props[i])

private var desc_one: Desc = Desc(Kind(&trace_by_desc, null, null, null), 1, 11)
private var desc_all: Desc = Desc(Kind(&trace_by_desc, null, null, null), SLOTS, 22)

@test("a descriptor that begins with a Kind is found through kind_of and traces by its own data")
descriptor_found_through_kind_of()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)

    val one = new_obj_of(&h, 1, &desc_one.kind)
    val all = new_obj_of(&h, 2, &desc_all.kind)
    val d: *Desc = ptr_cast(kind_of(ptr_cast(all)))
    assert_eq(d.tag, 22, "the client's own field, read through kind_of")

    // `one` traces only its first slot and `all` every slot, so what survives says which
    // descriptor each tracer read.
    one.props[0] = ptr_cast(new_obj(&h, 3))
    one.props[1] = ptr_cast(new_obj(&h, 4))
    all.props[0] = ptr_cast(new_obj(&h, 5))
    all.props[3] = ptr_cast(new_obj(&h, 6))

    root_a = ptr_cast(one)
    root_b = ptr_cast(all)
    collect(&h, &roots_ab)
    assert_eq(live(&h), 5, "one, all, one's first slot and both of all's; one's second slot dies")
    root_a = null
    root_b = null

// A constant built outside the arena, laid out as the contract says: a kind pointer, then a word the
// client leaves zero, then the payload.
private struct Forged
    kind: *Kind
    word: usize
    value: Obj

private var forged: Forged = Forged(&obj_kind, 0, Obj(7, [null; SLOTS]))

private forged_payload() -> *u8 = ptr_cast(&forged.value)

@test("kind_of answers for a constant outside the arena whose kind word the client forged")
kind_of_on_a_forged_constant()
    assert(kind_of(forged_payload()) == &obj_kind, "the forged kind")
    assert_eq(forged.word, 0, "and the word after it is the client's zero")

// -- The checks option ----------------------------------------------------------------------------
//
// Each of these traps only with `checks` on, so with it off each one says it was skipped rather than
// reporting a pass it did not earn. `sysl test . --option checks=true` runs them.

private needs_checks()
    if !option_checks then skip("the checks option is off: run with --option checks=true")

@test("under checks, an allocation naming no kind traps", should_trap)
checks_trap_a_null_kind()
    needs_checks()
    var block = fresh(4096)
    var h = heap(&block[0], 4096, null)
    alloc(&h, 16, null)

private var traceless_kind: Kind = Kind(null, null, null, null)

@test("under checks, an allocation naming a kind with no tracer traps", should_trap)
checks_trap_a_kind_without_a_tracer()
    needs_checks()
    var block = fresh(4096)
    var h = heap(&block[0], 4096, null)
    alloc_raw(&h, 16, &traceless_kind)

@test("under checks, marking an object the last sweep freed traps", should_trap)
checks_trap_a_mark_of_a_freed_object()
    needs_checks()
    var block = fresh(4096)
    var h = heap(&block[0], 4096, null)
    val p: *u8 = ptr_cast(new_obj(&h, 1))
    collect(&h, &no_roots)
    mark(&h, p)

@test("under checks, is_live of an object the last sweep freed traps", should_trap)
checks_trap_is_live_of_a_freed_object()
    needs_checks()
    var block = fresh(4096)
    var h = heap(&block[0], 4096, null)
    new_obj(&h, 0)
    val p: *u8 = ptr_cast(new_obj(&h, 1))
    collect(&h, &no_roots)
    is_live(&h, p)

@test("under checks, marking a pointer into the middle of a payload traps", should_trap)
checks_trap_a_misaligned_mark()
    needs_checks()
    var block = fresh(4096)
    var h = heap(&block[0], 4096, null)
    val p: *u8 = ptr_cast(new_obj(&h, 1))
    mark(&h, &p[8])

@test("under checks, a sweep over a block whose length was overwritten traps", should_trap)
checks_trap_a_broken_tiling()
    needs_checks()
    var block = fresh(4096)
    var h = heap(&block[0], 4096, null)
    root_a = ptr_cast(new_obj(&h, 1))
    val last: *u8 = ptr_cast(new_obj(&h, 2))

    // The word after the kind is the collector's length word; a grain more than the block is a
    // block that runs past the end of the used part. The first object is kept, so the only thing
    // wrong with the heap the sweep leaves is the tiling.
    var size_word: *usize = ptr_cast(usize(last) - KIND_BACK + sizeof(usize))
    size_word[0] = size_word[0] + GRAIN
    collect(&h, &roots_ab)

@test("with checks on or off, a well-formed heap runs every operation without a trap")
checks_pass_a_well_formed_heap()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)

    for round in 0..<4
        val keep = new_obj(&h, round)
        keep.props[0] = ptr_cast(new_chain(&h, round))
        new_obj(&h, 100 + round)
        alloc(&h, 0, &obj_kind)
        alloc(&h, 2000, &chain_kind)
        root_a = ptr_cast(keep)
        collect(&h, &roots_ab)
        assert_mask_agrees(&h, "after a checked sweep")
    dispose(&h)
    assert_eq(live(&h), 0)
    root_a = null

// -- The four-word header -------------------------------------------------------------------------

@test("a header is three words, so a zero-byte object costs that rounded to a grain")
header_is_three_words()
    var block = fresh(4096)
    var h = heap(&block[0], 4096, null)
    val words = 3 * sizeof(usize)
    val zero = (words + GRAIN - 1) / GRAIN * GRAIN

    val p = alloc(&h, 0, &obj_kind)
    assert_eq(used(&h), zero, "one header, rounded, and nothing else")
    assert_eq(block_bytes(p), zero)
    assert_eq(block_length(0), zero)
    assert_eq(block_length(zero - words), zero, "a payload that fills the header's last grain costs nothing more")
    assert_eq(block_length(8), 32, "an 8-byte payload, a box, is two grains on any target")
    assert_eq(block_length(16), (words + 16 + GRAIN - 1) / GRAIN * GRAIN)
    assert(usize(p) % GRAIN == 0, "and the payload is still 16-byte aligned")

// A kind with nothing to trace, for payloads of any length -- including ones too short to be an Obj.
private var leaf_kind: Kind = Kind(&trace_nothing, null, null, null)

@test("each block's length, mark and free flag round-trip through allocation, marking and the sweep")
header_word_round_trips()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)
    var objs: [48]*u8 = [null; 48]

    for i in 0..<48
        objs[i] = alloc(&h, i * 5, &leaf_kind)
        assert_eq(block_bytes(objs[i]), block_length(i * 5), "a fresh block is as long as its request rounds to")
        assert(!block_marked(objs[i]) && !block_free(objs[i]), "and neither marked nor free")

    // Grey every third object by hand, as a root set would; the rest stay white.
    for i in 0..<48
        if i % 3 == 0 then mark(&h, objs[i])
    for i in 0..<48
        assert(block_marked(objs[i]) == (i % 3 == 0), "a mark sets exactly its own object's bit")
        assert_eq(block_bytes(objs[i]), block_length(i * 5), "and leaves every length alone")
        assert(!block_free(objs[i]))

    collect(&h, &no_roots)
    assert_eq(live(&h), 16, "the greyed third survives")
    for i in 0..<48
        if i % 3 == 0
            assert(!block_marked(objs[i]), "the sweep clears a survivor's mark")
            assert(!block_free(objs[i]))
            assert_eq(block_bytes(objs[i]), block_length(i * 5), "and keeps its length")
        else
            assert(block_free(objs[i]), "a dead object's header says free")

    // The survivors are still well-formed objects: a second collection marks them again from roots.
    root_a = objs[0]
    collect(&h, &roots_ab)
    assert_eq(live(&h), 1)
    assert(!block_marked(objs[0]) && !block_free(objs[0]))
    root_a = null
end header_word_round_trips

@test("the largest block an arena allows is held, marked, swept and reused with its length intact")
largest_block_round_trips()
    var block = fresh(4096)
    var h = heap(&block[0], 4096, null)
    val top = (arena_room(&h) & ~(GRAIN - 1)) - header_bytes()

    assert(alloc(&h, top + 1, &obj_kind) == null, "a byte more than the largest does not fit")
    val p = alloc(&h, top, &obj_kind)
    assert(p != null)
    assert_eq(block_bytes(p), used(&h), "one block covers the whole used part")

    root_a = p
    collect(&h, &roots_ab)
    assert_eq(live_size(&h), block_bytes(p), "kept, at its full length")
    assert(!block_marked(p) && !block_free(p))

    root_a = null
    collect(&h, &no_roots)
    assert_eq(live(&h), 0)
    assert(block_free(p), "freed whole")
    assert(alloc(&h, top, &obj_kind) == p, "and handed back whole")
end largest_block_round_trips

@test("the longest block the header word can hold is the arena's limit, and a request past it is refused")
largest_length_the_word_holds()
    var block = fresh(64)
    var h = heap(&block[0], ~0usize, null)
    val most = arena_room(&h)

    // The arena is cut so that its largest request rounds to every bit of a word but the four the
    // flags use -- exactly the longest length a header can say, with nothing to spare and no wrap.
    assert_eq(block_length(most), ~(GRAIN - 1), "the longest length a header can hold")
    assert_eq(block_length(most) & (GRAIN - 1), 0, "with the flag bits clear")
    assert(alloc(&h, most + 1, &obj_kind) == null, "one byte more is refused before any arithmetic")
    assert(alloc(&h, ~0usize, &obj_kind) == null)
    assert_eq(used(&h), 0, "and nothing was handed out")
end largest_length_the_word_holds

// A tracer that counts its calls, so a test can tell an object was traced once and not twice.
private var traced: int = 0

private trace_counting(p: *u8, h: *Heap)
    traced += 1
    trace_obj(p, h)

private var counting_kind: Kind = Kind(&trace_counting, null, null, null)

@test("an object that points at itself is traced once")
self_cycle_traced_once()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)
    val o = new_obj_of(&h, 1, &counting_kind)
    o.props[0] = ptr_cast(o)
    o.props[1] = ptr_cast(o)

    traced = 0
    root_a = ptr_cast(o)
    collect(&h, &roots_ab)
    assert_eq(traced, 1)
    assert_eq(live(&h), 1)
    root_a = null

@test("an object reached from two parents and from a root is traced once")
shared_child_traced_once()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)
    val a = new_obj_of(&h, 1, &counting_kind)
    val b = new_obj_of(&h, 2, &counting_kind)
    val c = new_obj_of(&h, 3, &counting_kind)
    a.props[0] = ptr_cast(c)
    b.props[2] = ptr_cast(c)
    a.props[1] = ptr_cast(b)

    traced = 0
    root_a = ptr_cast(a)
    root_b = ptr_cast(c)
    collect(&h, &roots_ab)
    assert_eq(traced, 3, "a, b and c, once each")
    assert_eq(live(&h), 3)

    traced = 0
    collect(&h, &roots_ab)
    assert_eq(traced, 3, "and once each again in the next collection")
    root_a = null
    root_b = null

// An ephemeron that marks every live key's value whether or not it is already marked. Its first pass
// answers `true`, so the collector drains the worklist after it: a value the re-mark wrongly queued
// would be traced a second time there.
private var remark_passes: int = 0

private ephemeron_remark(p: *u8, h: *Heap) -> bool
    var m: *WeakMap = ptr_cast(p)
    for i in 0..<ENTRIES
        if m.keys[i] != null && is_live(h, m.keys[i])
            mark(h, m.vals[i])
    remark_passes += 1
    remark_passes == 1

private var remark_kind: Kind = Kind(&trace_nothing, null, null, &ephemeron_remark)

@test("an ephemeron that marks an already-marked value does not trace it twice")
ephemeron_remark_is_a_no_op()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)
    val raw = alloc(&h, sizeof(WeakMap), &remark_kind)
    var m: *WeakMap = ptr_cast(raw)
    val key = new_obj_of(&h, 1, &counting_kind)
    val value = new_obj_of(&h, 2, &counting_kind)
    key.props[0] = ptr_cast(value)
    m.keys[0] = ptr_cast(key)
    m.vals[0] = ptr_cast(value)

    traced = 0
    remark_passes = 0
    root_a = raw
    root_b = ptr_cast(key)
    collect(&h, &roots_ab)
    assert_eq(remark_passes, 2, "a pass that answered true, then one that answered false")
    assert_eq(traced, 2, "the key and its value, once each, though the ephemeron marked the value again")
    assert_eq(live(&h), 3)
    root_a = null
    root_b = null

// -- mark's range test -----------------------------------------------------------------------------
//
// These run with `checks` off and on alike: an address outside the arena is legal either way. What
// the option changes is only whether `foreign_marks` counts it.

// What `foreign_marks` should read after `n` out-of-arena marks: `n` under checks, zero without.
private foreign_expected(n: usize) -> usize = if option_checks then n else 0

@test("mark ignores null, is_live answers false for it, and neither counts it as foreign")
mark_ignores_null()
    var block = fresh(4096)
    var h = heap(&block[0], 4096, null)
    new_obj(&h, 1)

    mark(&h, null)
    assert(!is_live(&h, null))
    assert_eq(foreign_marks(&h), 0, "null is not a foreign pointer")

    root_a = null
    root_b = null
    collect(&h, &roots_ab)
    assert_eq(live(&h), 0)
    assert_eq(foreign_marks(&h), 0)

@test("a constant outside the arena with a forged kind passes through mark, is_live and kind_of untouched")
forged_constant_through_mark()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)
    val o = new_obj(&h, 1)
    val f = forged_payload()

    // A heap object pointing at the constant, and the constant as a root of its own.
    o.props[0] = f
    root_a = ptr_cast(o)
    root_b = f
    collect(&h, &roots_ab)

    assert_eq(live(&h), 1, "the heap object survives; the constant is not counted as one")
    assert(kind_of(f) == &obj_kind, "its kind word is as the client wrote it")
    assert_eq(forged.word, 0, "and the word after it was not touched: no mark was written")
    assert_eq(forged.value.tag, 7)
    assert(is_live(&h, f), "a constant is always live")
    assert_eq(foreign_marks(&h), foreign_expected(2), "reached twice: from the root and from the object")

    root_a = null
    root_b = null
    collect(&h, &roots_ab)
    assert_eq(live(&h), 0)
    assert_eq(forged.word, 0, "a sweep does not reach it either")

@test("a weak reference to a constant is never cleared")
weak_ref_to_a_constant_stays()
    var block = fresh(65536)
    var h = heap(&block[0], 65536, null)
    val w = new_weakref(&h, forged_payload())

    root_a = ptr_cast(w)
    collect(&h, &roots_ab)
    assert(w.target == forged_payload(), "is_live answers true for a constant, so the weaker leaves it")
    collect(&h, &roots_ab)
    assert(w.target == forged_payload())
    root_a = null

@test("mark ignores the arena's base, the addresses around its used part, and everything past it")
mark_ignores_addresses_at_the_arena_edges()
    var block = fresh(4096 + 64)
    var h = heap(&block[32], 4096, null)
    val base = arena_base(&h)
    val a = new_obj(&h, 1)
    val b = new_obj(&h, 2)
    val top = used(&h)

    // The base is never a payload -- the first payload is a header past it -- and nothing before it,
    // or at or after one header past the used part, can be an object's payload either.
    val strays: [6]*u8 = [base, &base[top + block_length(0)], &base[top + 512], &base[arena_room(&h)], &block[0], &block[16]]

    for s in strays
        mark(&h, s)
        assert(is_live(&h, s), "an address outside the objects is live: it is not the collector's")
    assert_eq(foreign_marks(&h), foreign_expected(6))

    assert(!block_marked(ptr_cast(a)) && !block_marked(ptr_cast(b)), "no stray mark touched an object")
    assert_eq(used(&h), top)

    root_a = ptr_cast(b)
    collect(&h, &roots_ab)
    assert_eq(live(&h), 1, "and the heap collects as if the strays were never marked")
    assert_eq(ptr_cast[*Obj](root_a).tag, 2)
    root_a = null
end mark_ignores_addresses_at_the_arena_edges

@test("a zero-byte object at the top of the used part is marked: its payload is a header into its block")
zero_byte_object_at_the_top_is_in_range()
    var block = fresh(4096)
    var h = heap(&block[0], 4096, null)
    new_obj(&h, 1)
    val z = alloc(&h, 0, &leaf_kind)

    assert(z == &arena_base(&h)[used(&h) - block_length(0) + header_bytes()], "the last block's payload")
    root_a = z
    collect(&h, &roots_ab)
    assert_eq(live(&h), 1, "it survives, so mark took it as an object")
    assert_eq(foreign_marks(&h), 0)
    assert(!block_free(z))
    root_a = null
    collect(&h, &roots_ab)
    assert_eq(live(&h), 0)

@test("foreign_marks counts each out-of-arena mark under checks and stays zero without")
foreign_marks_is_a_stat()
    var block = fresh(4096)
    var h = heap(&block[0], 4096, null)
    var other_block = fresh(4096)
    var other = heap(&other_block[0], 4096, null)
    val theirs: *u8 = ptr_cast(new_obj(&other, 1))
    val ours: *u8 = ptr_cast(new_obj(&h, 2))

    assert_eq(foreign_marks(&h), 0, "a new heap has counted nothing")
    for i in 0..<5
        mark(&h, theirs)
    mark(&h, ours)
    mark(&h, null)
    assert_eq(foreign_marks(&h), foreign_expected(5), "another heap's object is foreign to this one; ours and null are not")
    assert_eq(foreign_marks(&other), 0, "and the other heap counted nothing")
    assert(!block_marked(theirs), "the other heap's object was not marked")
    assert(block_marked(ours))

    collect(&h, &no_roots)
    assert_eq(foreign_marks(&h), foreign_expected(5), "a collection does not reset it")
    dispose(&h)
    assert_eq(foreign_marks(&h), foreign_expected(5), "nor does dispose: it counts since the heap was made")
end foreign_marks_is_a_stat
